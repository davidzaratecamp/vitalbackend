NODE_ENV=development
PORT=4100
CORS_ORIGIN=http://localhost:5180

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vital_db

JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Llave AES-256 (32 bytes en base64) para cifrar el número completo de
# tarjeta. Generarla con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cámbiala en cada entorno — nunca reutilices la misma llave en dev y prod.
CARD_ENCRYPTION_KEY=cambia-esto-genera-una-llave-de-32-bytes-en-base64

SEED_ADMIN_NAME=Administrador Vital
SEED_ADMIN_EMAIL=admin@vital.local
SEED_ADMIN_PASSWORD=cambia-esta-clave

# Solo para scripts/seed-demo.js — clave que tendrán las cuentas demo que
# genera (agentes/backoffice de prueba). No tiene default: si falta, el
# script se niega a correr.
SEED_DEMO_PASSWORD=cambia-esta-clave
